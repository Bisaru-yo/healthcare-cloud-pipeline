-- Generated locally with this computer's PUBLIC key. Run all in Snowflake.
USE ROLE ACCOUNTADMIN;
CREATE ROLE IF NOT EXISTS HEALTHCARE_TRANSFORMER;
GRANT ROLE HEALTHCARE_TRANSFORMER TO ROLE SYSADMIN;
GRANT USAGE ON WAREHOUSE HEALTHCARE_WH TO ROLE HEALTHCARE_TRANSFORMER;
GRANT USAGE ON DATABASE HEALTHCARE TO ROLE HEALTHCARE_TRANSFORMER;
GRANT USAGE ON SCHEMA HEALTHCARE.RAW TO ROLE HEALTHCARE_TRANSFORMER;
GRANT SELECT ON TABLE HEALTHCARE.RAW.PATIENTS TO ROLE HEALTHCARE_TRANSFORMER;
GRANT SELECT ON TABLE HEALTHCARE.RAW.PAYERS TO ROLE HEALTHCARE_TRANSFORMER;
GRANT SELECT ON TABLE HEALTHCARE.RAW.ENCOUNTERS TO ROLE HEALTHCARE_TRANSFORMER;
GRANT USAGE ON SCHEMA HEALTHCARE.ANALYTICS TO ROLE HEALTHCARE_TRANSFORMER;
GRANT CREATE TABLE, CREATE VIEW ON SCHEMA HEALTHCARE.ANALYTICS TO ROLE HEALTHCARE_TRANSFORMER;
CREATE USER IF NOT EXISTS HEALTHCARE_DBT_USER
    TYPE = SERVICE
    DEFAULT_ROLE = HEALTHCARE_TRANSFORMER
    DEFAULT_WAREHOUSE = HEALTHCARE_WH
    COMMENT = 'Healthcare portfolio dbt service user';
ALTER USER HEALTHCARE_DBT_USER SET RSA_PUBLIC_KEY = '__PUBLIC_KEY__';
ALTER USER HEALTHCARE_DBT_USER SET TIMEZONE = 'UTC';
GRANT ROLE HEALTHCARE_TRANSFORMER TO USER HEALTHCARE_DBT_USER;
SHOW GRANTS TO USER HEALTHCARE_DBT_USER;
