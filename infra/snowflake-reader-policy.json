{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProjectBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::bishal-healthcare-pipeline-bisar01"
    },
    {
      "Sid": "ListOnlyHealthcarePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::bishal-healthcare-pipeline-bisar01",
      "Condition": {
        "StringLike": {"s3:prefix": ["healthcare/", "healthcare/*"]}
      }
    },
    {
      "Sid": "ReadHealthcareObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::bishal-healthcare-pipeline-bisar01/healthcare/*"
    }
  ]
}
