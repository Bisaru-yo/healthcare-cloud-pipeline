# Copy to .env and choose a local-only password. Do not commit .env.
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST_PORT=15432
# Set DATABASE_URL in your terminal. Use URL encoding for password special characters.
# DATABASE_URL=postgresql://healthcare:YOUR_PASSWORD@127.0.0.1:15432/healthcare
# AWS uses the SDK's normal credential chain; never paste keys into source files.
AWS_REGION=us-east-2
S3_BUCKET=
